{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/card.vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        },
        {
          "key": "Content-Disposition",
          "value": "inline; filename=\"listing-pixl.vcf\""
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/507-adriatic-ave-north-cape-may-nj.html",
      "destination": "/blog/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/staff",
      "destination": "/api/staff"
    },
    {
      "source": "/staff/",
      "destination": "/api/staff"
    },
    {
      "source": "/staff/shoots",
      "destination": "/api/shoots"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "draft-request/**": false,
      "publish-request/**": false
    }
  },
  "functions": {
    "api/shoots.js": {
      "maxDuration": 60
    },
    "api/prices.js": {
      "maxDuration": 20
    }
  }
}
