{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/507-adriatic-ave-north-cape-may-nj.html",
      "destination": "/blog/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/staff",
      "destination": "/api/staff"
    },
    {
      "source": "/staff/",
      "destination": "/api/staff"
    }
  ]
}
