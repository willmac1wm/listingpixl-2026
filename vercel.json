{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "SAMEORIGIN",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=(), payment=()"
      },
      "continue": true
    },
    {
      "src": "/card\\.vcf",
      "headers": {
        "Content-Type": "text/vcard; charset=utf-8",
        "Content-Disposition": "inline; filename=\"listing-pixl.vcf\""
      },
      "continue": true
    },
    {
      "src": "/blog/507-adriatic-ave-north-cape-may-nj\\.html",
      "headers": {
        "Location": "/blog/"
      },
      "status": 308
    },
    {
      "src": "/(?:index\\.html)?",
      "dest": "/api/home"
    },
    {
      "src": "/staff/login/?",
      "dest": "/api/staff-auth"
    },
    {
      "src": "/staff/logout/?",
      "dest": "/api/staff-auth?mode=logout"
    },
    {
      "src": "/staff/?",
      "dest": "/api/staff"
    },
    {
      "src": "/staff/shoots",
      "dest": "/api/shoots"
    },
    {
      "src": "/staff/recipes",
      "dest": "/api/staff-recipes"
    },
    {
      "src": "/staff/clips",
      "dest": "/api/staff-recipes?mode=clips"
    },
    {
      "src": "/staff/delivery",
      "dest": "/api/staff-delivery"
    },
    {
      "src": "/gallery/([a-f0-9]+)",
      "dest": "/api/gallery?token=$1"
    },
    {
      "src": "/staff/inquiries/?",
      "dest": "/api/inquiries"
    },
    {
      "handle": "filesystem"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "draft-request/**": false,
      "publish-request/**": false
    }
  },
  "functions": {
    "api/shoots.js": {
      "maxDuration": 60
    },
    "api/staff-recipes.js": {
      "maxDuration": 60
    },
    "api/staff-delivery.js": {
      "maxDuration": 30
    },
    "api/gallery.js": {
      "maxDuration": 15
    },
    "api/prices.js": {
      "maxDuration": 20
    },
    "api/home.js": {
      "maxDuration": 15,
      "includeFiles": "index.html"
    },
    "api/book.js": {
      "maxDuration": 30
    },
    "api/staff-auth.js": {
      "maxDuration": 30
    },
    "api/inquiries.js": {
      "maxDuration": 30
    }
  }
}
