{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/507-adriatic-ave-north-cape-may-nj.html",
      "destination": "/blog/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/home"
    },
    {
      "source": "/index.html",
      "destination": "/api/home"
    },
    {
      "source": "/staff",
      "destination": "/api/staff"
    },
    {
      "source": "/staff/",
      "destination": "/api/staff"
    },
    {
      "source": "/staff/shoots",
      "destination": "/api/shoots"
    },
    {
      "source": "/staff/inquiries",
      "destination": "/api/inquiries"
    },
    {
      "source": "/staff/inquiries/",
      "destination": "/api/inquiries"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "draft-request/**": false,
      "publish-request/**": false
    }
  },
  "functions": {
    "api/shoots.js": {
      "maxDuration": 60
    },
    "api/prices.js": {
      "maxDuration": 20
    },
    "api/home.js": {
      "maxDuration": 15,
      "includeFiles": "index.html"
    },
    "api/book.js": {
      "maxDuration": 30
    },
    "api/inquiries.js": {
      "maxDuration": 30
    }
  }
}
